FLEET_CENTER_URL=https://fleet.example.internal:8770
FLEET_NODE_ID=host-01
# Set FLEET_TOKEN only for the first enrollment, then remove it after agent-credential.json exists.
FLEET_TOKEN=bootstrap-only-remove-after-first-enrollment
FLEET_ORDERS_DSN=postgres://monitor:password@127.0.0.1:5432/orders?sslmode=require
FLEET_REDIS_PASSWORD=replace-with-a-read-only-secret
FLEET_AGENT_ARGS=--interval 30s --spool-dir /var/lib/fleetscope-agent --infrascout /usr/local/bin/infrascout --state-dir /var/lib/infrascout --probes /etc/fleetscope/probes.json --applications /etc/fleetscope/applications.json --ca /etc/fleetscope/ca.pem --label environment=production --label version=1.2.3
