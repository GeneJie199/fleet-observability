[Unit]
Description=FleetScope node agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/fleetscope/agent.env
ExecStart=/usr/local/bin/fleetctl agent --center ${FLEET_CENTER_URL} --node ${FLEET_NODE_ID} ${FLEET_AGENT_ARGS}
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/infrascout /var/lib/fleetscope-agent

[Install]
WantedBy=multi-user.target
