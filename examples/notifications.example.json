{
  "channels": [
    {
      "id": "operations-feishu",
      "type": "feishu",
      "enabled": true,
      "endpoint_env": "FLEET_FEISHU_WEBHOOK"
    },
    {
      "id": "incident-webhook",
      "type": "webhook",
      "enabled": true,
      "endpoint_env": "FLEET_INCIDENT_WEBHOOK",
      "headers_env": {
        "Authorization": "FLEET_INCIDENT_AUTHORIZATION"
      }
    }
  ],
  "policy": {
    "dedupe_window_seconds": 900,
    "max_queue": 5000,
    "max_attempts": 8,
    "initial_retry_seconds": 5,
    "suppressions": [],
    "deployment_windows": []
  }
}
